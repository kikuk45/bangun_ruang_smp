%%writefile app.py
import streamlit as st
import plotly.graph_objects as px
import numpy as np

# Konfigurasi Halaman
st.set_page_config(page_title="Media Pembelajaran Geometri SMP", layout="wide")

# Header Aplikasi
st.title("📐 Media Pembelajaran Geometri Interaktif")
st.subheader("Materi: Bangun Ruang Sisi Datar (SMP)")
st.write("Selamat belajar! Pilih bangun ruang di menu samping untuk mulai mengeksplorasi.")

# Sidebar untuk Navigasi
menu = st.sidebar.selectbox("Pilih Bangun Ruang:", ["Home", "Kubus", "Balok"])

# --- HALAMAN UTAMA (HOME) ---
if menu == "Home":
    st.markdown("""
    ### Halo, Calon Ahli Matematika! 👋
    Aplikasi ini dirancang untuk membantu kamu memahami konsep **Bangun Ruang Sisi Datar** dengan lebih mudah dan menyenangkan.
    
    **Fitur yang bisa kamu coba:**
    * 🧊 **Visualisasi 3D:** Kamu bisa memutar dan melihat bentuk bangun ruang dari berbagai sudut.
    * 🧮 **Kalkulator Pintar:** Hitung Luas Permukaan dan Volume secara instan.
    * 📝 **Kuis Interaktif:** Uji pemahamanmu setelah belajar.
    """)

# --- HALAMAN KUBUS ---
elif menu == "Kubus":
    st.header("🧊 Bangun Ruang: Kubus")
    
    col1, col2 = st.columns([1, 1])
    
    with col1:
        st.markdown("### Karakteristik Kubus")
        st.write("- Memiliki 6 sisi berbentuk persegi yang kongruen.")
        st.write("- Memiliki 12 rusuk yang sama panjang.")
        st.write("- Memiliki 8 titik sudut.")
        
        st.markdown("### 📝 Rumus Kubus")
        st.latex(r"Volume (V) = s \times s \times s = s^3")
        st.latex(r"Luas \ Permukaan \ (L) = 6 \times s^2")
        
        # Input Panjang Sisi
        sisi = st.number_input("Masukkan panjang sisi (s):", min_value=1.0, value=5.0, step=0.5)
        
        # Perhitungan
        volume = sisi ** 3
        luas_permukaan = 6 * (sisi ** 2)
        
        st.success(f"**Hasil Perhitungan (sisi = {sisi}):**")
        st.write(f"🔹 **Volume:** {volume:.2f} satuan kubik")
        st.write(f"🔹 **Luas Permukaan:** {luas_permukaan:.2f} satuan persegi")

    with col2:
        st.markdown("### Visualisasi 3D")
        # Membuat koordinat 3D untuk kubus sederhana menggunakan Plotly
        s = sisi
        x = [0, s, s, 0, 0, s, s, 0]
        y = [0, 0, s, s, 0, 0, s, s]
        z = [0, 0, 0, 0, s, s, s, s]
        
        fig = px.figure(data=[
            px.Mesh3d(
                x=x, y=y, z=z,
                i=[7, 0, 0, 0, 4, 4, 2, 6, 4, 0, 3, 7],
                j=[3, 4, 1, 2, 5, 6, 5, 2, 0, 1, 6, 3],
                k=[0, 7, 2, 3, 6, 7, 1, 1, 5, 5, 7, 2],
                opacity=0.6,
                color='lightblue',
                flatshading=True
            )
        ])
        fig.update_layout(scene=dict(xaxis_title='X', yaxis_title='Y', zaxis_title='Z'), margin=dict(l=0, r=0, b=0, t=0))
        st.plotly_chart(fig, use_container_width=True)

# --- HALAMAN BALOK ---
elif menu == "Balok":
    st.header("🧱 Bangun Ruang: Balok")
    
    col1, col2 = st.columns([1, 1])
    
    with col1:
        st.markdown("### Karakteristik Balok")
        st.write("- Memiliki 6 sisi, di mana sisi yang berhadapan sejajar dan sama besar.")
        st.write("- Memiliki 12 rusuk (terdiri dari 4 panjang, 4 lebar, dan 4 tinggi).")
        st.write("- Memiliki 8 titik sudut.")
        
        st.markdown("### 📝 Rumus Balok")
        st.latex(r"Volume (V) = p \times l \times t")
        st.latex(r"Luas \ Permukaan \ (L) = 2 \times ((p \times l) + (p \times t) + (l \times t))")
        
        # Input Dimensi Balok
        p = st.number_input("Masukkan Panjang (p):", min_value=1.0, value=6.0, step=0.5)
        l = st.number_input("Masukkan Lebar (l):", min_value=1.0, value=4.0, step=0.5)
        t = st.number_input("Masukkan Tinggi (t):", min_value=1.0, value=3.0, step=0.5)
        
        # Perhitungan
        v_balok = p * l * t
        lp_balok = 2 * ((p * l) + (p * t) + (l * t))
        
        st.success("**Hasil Perhitungan:**")
        st.write(f"🔹 **Volume:** {v_balok:.2f} satuan kubik")
        st.write(f"🔹 **Luas Permukaan:** {lp_balok:.2f} satuan persegi")

    with col2:
        st.markdown("### Visualisasi 3D")
        # Membuat koordinat 3D untuk balok
        x = [0, p, p, 0, 0, p, p, 0]
        y = [0, 0, l, l, 0, 0, l, l]
        z = [0, 0, 0, 0, t, t, t, t]
        
        fig = px.figure(data=[
            px.Mesh3d(
                x=x, y=y, z=z,
                i=[7, 0, 0, 0, 4, 4, 2, 6, 4, 0, 3, 7],
                j=[3, 4, 1, 2, 5, 6, 5, 2, 0, 1, 6, 3],
                k=[0, 7, 2, 3, 6, 7, 1, 1, 5, 5, 7, 2],
                opacity=0.6,
                color='lightgreen',
                flatshading=True
            )
        ])
        fig.update_layout(scene=dict(xaxis_title='X', yaxis_title='Y', zaxis_title='Z'), margin=dict(l=0, r=0, b=0, t=0))
        st.plotly_chart(fig, use_container_width=True)

# Footer sederhana
st.sidebar.markdown("---")
st.sidebar.caption("Dikembangkan untuk Media Pembelajaran Matematika SMP.")
